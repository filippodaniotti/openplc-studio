# =============================================================================
# PLC Testbench Platform - production environment
# =============================================================================
# Copy this file to .env and edit the values before running:
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is read automatically by `docker compose` from this directory.
# Never commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Container architecture
# -----------------------------------------------------------------------------
# The released application images currently support linux/amd64 only. This lets
# Docker Desktop on Apple Silicon emulate amd64; use linux/arm64 after native
# images are published. Infrastructure images choose their native platform.
APP_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# Public entrypoint
# -----------------------------------------------------------------------------
# Host port the reverse proxy is published on. Open http://<host>:<HTTP_PORT>.
HTTP_PORT=6767

# -----------------------------------------------------------------------------
# MongoDB credentials (REQUIRED - the stack refuses to start without them)
# -----------------------------------------------------------------------------
# These are also used by the backend to authenticate against MongoDB.
# Changing them after the first start requires wiping/updating the mongo volume.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me

# Database the application uses inside MongoDB.
MONGO_DATABASE=plc-testbench

# -----------------------------------------------------------------------------
# Redis (dramatiq broker)
# -----------------------------------------------------------------------------
# Points at the bundled `redis` service. Change only if using an external Redis.
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Backend storage (container-internal paths)
# -----------------------------------------------------------------------------
# Keep the "./<single-directory>" shape: the artifact export logic strips the
# first two path segments, so absolute or deeper paths change the archive layout.
PLC_ROOT_FOLDER=./artifacts-storage
PLUGINS_DIRECTORY=./user-plugins

# CI publishes "latest" and an immutable "sha-<full-git-sha>" tag on every
# push to master. Keep latest for easy upgrades. For a repeatable deployment,
# pin each image to the sha-* tag from its own repository's workflow run.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
